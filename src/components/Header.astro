---
import { siteConfig } from '../data/site';
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="Stitch Home">
      <img src="/favicon-32x32.png" alt="Stitch App Icon" class="brand-logo" width="28" height="28" />
      <span class="wordmark">{siteConfig.name}</span>
    </a>
    
    <nav class="nav" aria-label="Main navigation">
      <a href="/privacy-policy" class="nav-link">Privacy</a>
      <a href="/support" class="nav-link">Support</a>
      <a href={siteConfig.appStoreUrl} target="_blank" rel="noopener noreferrer" class="btn-primary nav-btn">
        Download
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--background);
    border-bottom: 1px solid var(--border);
    height: 64px;
    display: flex;
    align-items: center;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-logo {
    border-radius: 6px;
    display: block;
  }

  .wordmark {
    font-size: var(--font-size-18);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .brand-link:hover .wordmark {
    opacity: 0.9;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    font-size: var(--font-size-14);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-speed) ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .nav-btn {
    padding: 6px 14px;
    font-size: var(--font-size-14);
  }

  @media (max-width: 640px) {
    .nav-link {
      display: none;
    }
    .nav {
      gap: 0;
    }
  }
</style>
